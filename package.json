{
  "name": "node-calculator",
  "version": "1.0.0",
  "description": "Calculator",
  "repository": {
    "type": "git",
    "url": "https://github.com/demo/node-calculator.git"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo \"No build step required\"",
    "typecheck": "node --check server.js api/controller.js api/routes.js public/client.js test/arithmetic.test.js test/helpers.js gulpfile.js",
    "lint": "eslint ./api/**/*.js ./public/**/*.js ./test/**/*.js ./server.js ./gulpfile.js",
    "test": "nyc --reporter=cobertura --reporter=html --reporter=text mocha --timeout 10000 --reporter mocha-multi-reporters --reporter-options configFile=test/config.json && gulp inlinesource"
  },
  "keywords": [
    "azure",
    "pipelines",
    "devops",
    "vsts",
    "ci",
    "cd"
  ],
  "author": "Demo User",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "gulp": "^4.0.0",
    "gulp-inline-source": "^4.0.0",
    "mocha": "^11.7.4",
    "mocha-junit-reporter": "^2.2.1",
    "mocha-multi-reporters": "^1.5.1",
    "nodemon": "^3.1.10",
    "nyc": "^17.1.0",
    "supertest": "^7.1.4"
  },
  "bugs": {
    "url": "https://github.com/demo/node-calculator/issues"
  },
  "homepage": "https://github.com/demo/node-calculator#readme",
  "directories": {
    "test": "test"
  }
}
